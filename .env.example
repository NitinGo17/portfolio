# Copy to .env and fill in real values. Never commit .env.

# Postgres connection (India region for DPDP). Supabase Mumbai or Neon.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Session signing secret — generate with: openssl rand -base64 32
SESSION_SECRET=""

# Contact-form email delivery (provider API key — server-side only)
EMAIL_PROVIDER_API_KEY=""
CONTACT_TO_EMAIL=""

# Public site URL (used for canonical/OG)
NEXT_PUBLIC_SITE_URL="https://knowme.co.in"
